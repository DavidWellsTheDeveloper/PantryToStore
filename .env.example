# Copy to .env (never commit secrets). Public vars only — see PRD §7.5.
# Deployment target: AWS S3 + CloudFront (static). The only runtime piece is the
# serverless Spoonacular proxy (see PRD §7.2).

# Canonical site URL (used by SEO meta/canonical + sitemap)
NUXT_PUBLIC_SITE_URL=https://pantrytostore.example.com

# AdSense — leave empty until approved (ads render nothing without a slot)
NUXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NUXT_PUBLIC_ADSENSE_SLOT=

# Supabase (client-safe publishable keys)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=