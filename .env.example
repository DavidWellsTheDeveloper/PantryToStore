# Copy to .env (never commit secrets) — see PRD §7.5 for the full env contract.
# Deployment target: AWS S3 + CloudFront (static). The only runtime piece is the
# serverless Spoonacular proxy (see PRD §7.2).

# Canonical site URL (used by SEO meta/canonical + sitemap)
NUXT_PUBLIC_SITE_URL=https://pantrytostore.example.com

# Runtime base URL for the Spoonacular proxy.
# Empty = same-origin (local dev / during `nuxt generate`).
# On the static host, point at the deployed serverless proxy
# (e.g. https://api.pantrytostore.com) for client interactions like "Load more".
NUXT_PUBLIC_API_BASE=

# AdSense — leave empty until approved (ads render nothing without a slot)
NUXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NUXT_PUBLIC_ADSENSE_SLOT=

# Supabase (client-safe publishable keys)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: Spoonacular API key. Consumed by the /api/spoonacular/* proxy and
# the Lambda bundle in production (server side only — never reaches the client).
SPOONACULAR_API_KEY=